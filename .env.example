# Copy to .env.local (or set in your hosting platform) and rebuild.
# VITE_ values end up in the public JavaScript: never put secrets here.

# Recipient for the email fallback and the address shown on the site.
VITE_PROPOSAL_EMAIL=sergi.pasquale@outlook.com

# Optional: send the request form directly instead of opening the visitor's
# email app. Leave empty to keep the email fallback.
# VITE_FORM_ENDPOINT=https://api.web3forms.com/submit
# Web3Forms: public access key, sent as "access_key"
# VITE_FORM_ACCESS_KEY=
# "json" (default) or "form" (application/x-www-form-urlencoded)
# VITE_FORM_ENCODING=json
